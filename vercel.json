{
  "functions": {
    "api/**": {
      "runtime": "python3.11",
      "installCommand": "pip install -r requirements.txt",
      "buildCommand": "echo 'Backend has no build step'"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}