{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "backend/api/handler.py": {
      "runtime": "python3.11",
      "installCommand": "pip install -r backend/requirements.txt"
    }
  },
  "rewrites": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/handler.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/dist/index.html"
    }
  ]
}
